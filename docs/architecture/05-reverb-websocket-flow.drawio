<mxfile host="Electron" modified="2026-10-19T07:50:00.000Z" agent="Antigravity Architecture Documentation" version="24.0.0" type="device">
  <diagram id="easy-reverb-flow" name="5. Live Updates &amp; Reverb (Simple)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- HEADER BANNER -->
        <mxCell id="hdr5" value="&lt;b style=&quot;font-size: 22px;&quot;&gt;HTUT AI — Real-Time Generation Status Updates &amp;amp; WebSockets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 14px; color: #555;&quot;&gt;ဗီဒီယို ပြီး/မပြီး အခြေအနေကို User မျက်နှာပြင်တွင် Live သိရှိစေပုံ (Live Status &amp;amp; WebSockets)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#bcccdc;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1400" height="70" as="geometry" />
        </mxCell>

        <!-- SECTION 1: 4 VIDEO STATUS STAGES -->
        <mxCell id="box_stages" value="1. THE 4 GENERATION STATUS STAGES (ဗီဒီယို ပြောင်းလဲမှု အဆင့် ၄ ဆင့်)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontStyle=1;fontSize=13;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="1400" height="155" as="geometry" />
        </mxCell>

        <mxCell id="st_q" value="&lt;b style=&quot;font-size: 14px; color: #e65100;&quot;&gt;① QUEUED&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #555;&quot;&gt;Waiting in Redis Queue&lt;/span&gt;&lt;br&gt;&lt;b&gt;UI:&lt;/b&gt; Orange &amp;quot;Queued&amp;quot; Badge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ff9800;align=center;" vertex="1" parent="box_stages">
          <mxGeometry x="40" y="50" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="st_p" value="&lt;b style=&quot;font-size: 14px; color: #0277bd;&quot;&gt;② PROCESSING&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #555;&quot;&gt;Segmind AI is rendering video&lt;/span&gt;&lt;br&gt;&lt;b&gt;UI:&lt;/b&gt; Blue Spinner &amp;amp; Progress bar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#03a9f4;align=center;" vertex="1" parent="box_stages">
          <mxGeometry x="390" y="50" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="st_c" value="&lt;b style=&quot;font-size: 14px; color: #2e7d32;&quot;&gt;③ COMPLETED (Success)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #555;&quot;&gt;Uploaded to S3 Cloud Storage&lt;/span&gt;&lt;br&gt;&lt;b&gt;UI:&lt;/b&gt; Video Player &amp;amp; Download Button" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#4caf50;align=center;" vertex="1" parent="box_stages">
          <mxGeometry x="740" y="50" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="st_f" value="&lt;b style=&quot;font-size: 14px; color: #c62828;&quot;&gt;④ FAILED (Auto-Refund)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color: #555;&quot;&gt;Timeout or AI error&lt;/span&gt;&lt;br&gt;&lt;b&gt;UI:&lt;/b&gt; Red Alert &amp;amp; Points Refunded Notice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#f44336;align=center;" vertex="1" parent="box_stages">
          <mxGeometry x="1080" y="50" width="280" height="75" as="geometry" />
        </mxCell>

        <!-- ARROWS BETWEEN STAGES -->
        <mxCell id="arr_s1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ff9800;strokeWidth=2;" edge="1" parent="box_stages" source="st_q" target="st_p">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_s2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#03a9f4;strokeWidth=2;" edge="1" parent="box_stages" source="st_p" target="st_c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr_s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#f44336;strokeWidth=2;" edge="1" parent="box_stages" source="st_p" target="st_f">
          <mxGeometry relative="1" as="geometry">
            <Array points="690 90; 690 140; 1060 140; 1060 90" />
          </mxGeometry>
        </mxCell>

        <!-- SECTION 2: HOW THE SCREEN UPDATES (TWO PATHS) -->
        <mxCell id="box_two_paths" value="2. HOW THE USER'S SCREEN GETS UPDATED (မျက်နှာပြင်တွင် အခြေအနေပြသပုံ နည်းလမ်း ၂ မျိုး)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#9e9e9e;fontStyle=1;fontSize=13;startSize=35;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="310" width="1400" height="420" as="geometry" />
        </mxCell>

        <!-- METHOD A: POLLING FALLBACK (CURRENTLY ACTIVE) -->
        <mxCell id="col_poll" value="METHOD A: STATUS POLLING&#10;[CURRENTLY ACTIVE &amp;amp; WORKING]" style="swimlane;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontStyle=1;startSize=35;rounded=1;" vertex="1" parent="box_two_paths">
          <mxGeometry x="40" y="50" width="630" height="340" as="geometry" />
        </mxCell>
        <mxCell id="poll_how" value="&lt;b style=&quot;font-size: 14px; color: #2e7d32;&quot;&gt;How it works right now (ယခု အလုပ်လုပ်နေပုံ):&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. React sends: &lt;code&gt;GET /api/v1/ai/generations/{id}&lt;/code&gt; every 3 seconds.&lt;br&gt;&lt;br&gt;2. Server replies: &lt;i&gt;&amp;quot;Still processing...&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;3. When finished, server replies: &lt;i&gt;&amp;quot;Completed! Video URL: https://...&amp;quot;&lt;/i&gt;&lt;br&gt;&lt;br&gt;4. React stops asking and shows the video player!&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #2e7d32;&quot;&gt;✔ Very stable and works on 100% of mobile internet connections.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2e7d32;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="col_poll">
          <mxGeometry x="25" y="50" width="580" height="260" as="geometry" />
        </mxCell>

        <!-- METHOD B: REVERB WEBSOCKET (PENDING FRONTEND) -->
        <mxCell id="col_reverb" value="METHOD B: REVERB WEBSOCKET PUSH&#10;[BACKEND READY • FRONTEND PENDING]" style="swimlane;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontStyle=1;startSize=35;rounded=1;" vertex="1" parent="box_two_paths">
          <mxGeometry x="730" y="50" width="630" height="340" as="geometry" />
        </mxCell>
        <mxCell id="reverb_how" value="&lt;b style=&quot;font-size: 14px; color: #c2185b;&quot;&gt;Instant WebSocket Push (ချက်ချင်း အသိပေးသည့် စနစ်):&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Laravel Reverb server is running on &lt;code&gt;port 8080&lt;/code&gt;.&lt;br&gt;&lt;br&gt;2. When a video completes, backend fires &lt;code&gt;AIGenerationUpdated&lt;/code&gt; event.&lt;br&gt;&lt;br&gt;3. Reverb pushes update to browser in &lt;b style=&quot;color: #c2185b;&quot;&gt;0.01 seconds&lt;/b&gt; (no 3s delay!).&lt;br&gt;&lt;br&gt;&lt;b style=&quot;color: #c62828;&quot;&gt;Current Status:&lt;/b&gt; Backend is 100% ready. Connecting Laravel Echo client into React is the next frontend integration task." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c2185b;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="col_reverb">
          <mxGeometry x="25" y="50" width="580" height="260" as="geometry" />
        </mxCell>

        <!-- FOOTER -->
        <mxCell id="ftr5" value="&lt;b&gt;Result (ရလဒ်):&lt;/b&gt; Users currently have a fully functional experience via Polling (Method A). Upgrading to Reverb (Method B) in the frontend will make the updates feel instantaneous like magic." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#bdbdbd;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="1400" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
