# HTUT AI — Production environment template
#
# Usage on the VPS:
#   cp .env.production.example .env.production
#   nano .env.production          # fill every placeholder
#   php key is generated inside the container:
#     docker compose --env-file .env.production -f docker-compose.production.yml \
#       exec php php artisan key:generate --force
#
# NEVER commit the real .env.production (already gitignored).

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="HTUT AI"
APP_ENV=production
# Generate WITHOUT writing a .env file (the image has none):
#   docker compose --env-file .env.production -f docker-compose.production.yml \
#     run --rm php php artisan key:generate --show
APP_KEY=                # REQUIRED — paste the generated key here
APP_DEBUG=false
APP_URL=https://ai.htut.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database (Docker network names — never 127.0.0.1) ────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=htut-ai
DB_USERNAME=root
DB_PASSWORD=            # REQUIRED — generate a strong password

# ── Sessions / cache / queue ─────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (replace with real SMTP when email phase lands) ────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=              # e.g. smtp.postmarkapp.com / smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@htut.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Domains (session-cookie auth) ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=ai.htut.com
SESSION_SECURE_COOKIE=true

# ── AWS / DigitalOcean Spaces ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SEGMIND_API_KEY=

DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
DO_SPACES_REGION="sgp1"
DO_SPACES_BUCKET="imagesbucket"
DO_SPACES_PUBLIC="https://imagesbucket.sgp1.digitaloceanspaces.com/"

# ── Frontend ─────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Docker stack config (used by docker-compose.production.yml) ─────────
# APP_PORT=8080          # host port nginx reverse-proxies to (127.0.0.1 only)
# IMAGE_TAG=latest      # pin an image SHA to roll back a deploy
