# HTUT AI — Production environment template
#
# Usage on the VPS:
#   cp .env.production.example .env.production
#   nano .env.production          # fill every placeholder
#   php key is generated inside the container:
#     docker compose --env-file .env.production -f docker-compose.production.yml \
#       exec php php artisan key:generate --force
#
# NEVER commit the real .env.production (already gitignored).

# ── Application ──────────────────────────────────────────────────────────
APP_NAME="HTUT AI"
APP_ENV=production
# Generate WITHOUT writing a .env file (the image has none):
#   docker compose --env-file .env.production -f docker-compose.production.yml \
#     run --rm php php artisan key:generate --show
APP_KEY=                # REQUIRED — paste the generated key here
APP_DEBUG=false
APP_URL=https://ai.htut.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database (Docker network names — never 127.0.0.1) ────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=htut-ai
DB_USERNAME=root
DB_PASSWORD=            # REQUIRED — generate a strong password

# ── Sessions / cache / queue ─────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=spaces
QUEUE_CONNECTION=redis

CACHE_STORE=database

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── WebSockets / Laravel Reverb ──────────────────────────────────────────
REVERB_APP_ID=100001
REVERB_APP_KEY=htut-ai-reverb-key
REVERB_APP_SECRET=htut-ai-reverb-secret
REVERB_HOST="ws.htut.com"
REVERB_PORT=443
REVERB_SCHEME="https"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── HTUT Central Auth S2S ────────────────────────────────────────────────
HTUT_CENTRAL_AUTH_URL=https://auth.htut.com
HTUT_PROJECT_ID=htut-ai
HTUT_PROJECT_SECRET=
HTUT_API_KEY=

# ── Mail (replace with real SMTP when email phase lands) ────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=              # e.g. smtp.postmarkapp.com / smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@htut.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Domains (session-cookie auth) ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=ai.htut.com
SESSION_SECURE_COOKIE=true

# ── AWS / DigitalOcean Spaces ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SEGMIND_API_KEY=

DO_SPACES_KEY=""
DO_SPACES_SECRET=""
DO_SPACES_ENDPOINT="https://sgp1.digitaloceanspaces.com"
DO_SPACES_REGION="sgp1"
DO_SPACES_BUCKET="imagesbucket"
DO_SPACES_PUBLIC="https://imagesbucket.sgp1.digitaloceanspaces.com/"

# ── Frontend ─────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.htut.com
VITE_APP_NAME="${APP_NAME}"

# ── Google customer login ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.htut.com/api/v1/auth/google/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=
APPLE_REDIRECT_URI=https://api.htut.com/api/v1/auth/apple/callback

# ── Docker stack config (used by docker-compose.production.yml) ─────────
# IMAGE_NAME=ghcr.io/ai-face-swap/admin-dashboard   # Or registry.gitlab.com/... for GitLab
# IMAGE_TAG=latest                                   # Pin a commit SHA or tag
# APP_PORT=8080                                      # Host port Nginx proxies Web to (127.0.0.1)
# REVERB_PORT=8081                                   # Host port Nginx proxies WebSockets (ws.htut.com) to
